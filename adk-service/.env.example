# Vertex AI (production/judging) -- set both to route through Google Cloud
GOOGLE_CLOUD_PROJECT=s2pnexus
GOOGLE_CLOUD_LOCATION=global

# Gemini Developer API key (local/dev fallback only -- leave unset in
# production so calls go through Vertex AI, which is what satisfies the
# hackathon's "must use a Google Cloud product" requirement)
# GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash

# Shared-secret bearer token the S2PNexus backend must send. Leave unset for
# local dev; set it before deploying to Cloud Run (must match the backend's
# ADK_PIPELINE_TOKEN).
INTERNAL_TOKEN=
