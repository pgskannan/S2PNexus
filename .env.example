# S2PNexus Environment Variables Example
# Copy this file to .env and update values as needed

# Application
APP_NAME=S2PNexus
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database
POSTGRES_USER=s2pnexus
POSTGRES_PASSWORD=s2pnexus
POSTGRES_DB=s2pnexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://s2pnexus:s2pnexus@localhost:5432/s2pnexus

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=s2pnexus_documents

# Ollama (fallback provider; set AI_PROVIDER=ollama to use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
ENABLE_AI=true
ENABLE_RAG=false

# AI provider selection
AI_PROVIDER=gemini

# Gemini / Vertex AI (Google Cloud)
# Set GOOGLE_CLOUD_PROJECT to route through Vertex AI (satisfies the "Google Cloud product" requirement).
# Leave it unset and set GEMINI_API_KEY instead for local/dev testing against the Gemini Developer API.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=60

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Embeddings
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt", ".md", ".csv", ".xlsx"]