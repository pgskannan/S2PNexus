# Set default behavior, normalize all text files
* text=auto

# Explicit line endings per file types to avoid CRLF churn on Windows
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary

# Keep executable bit where relevant
*.sh    eol=lf
